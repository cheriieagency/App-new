# =============================================================================
# clikd: — apps/web environment template
# Copy to apps/web/.env.local and fill in real values. Never commit secrets.
# =============================================================================

# -----------------------------------------------------------------
# 1. AI COPILOT & LLM
# Get key at: https://platform.openai.com/api-keys
# -----------------------------------------------------------------
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o

# -----------------------------------------------------------------
# 2. META / INSTAGRAM GRAPH API
# Get keys at: https://developers.facebook.com/
# -----------------------------------------------------------------
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
META_WEBHOOK_VERIFY_TOKEN=YOUR_CUSTOM_VERIFY_TOKEN

# -----------------------------------------------------------------
# 3. TIKTOK DEVELOPER API (Login Kit + Content Posting)
# Get keys at: https://developers.tiktok.com/
# Enable: Login Kit, Content Posting API (video.publish Direct Post)
# Redirect URI (register both if you develop locally):
#   {APP_URL}/api/auth/callback/tiktok
#   http://localhost:4000/api/auth/callback/tiktok
# PULL_FROM_URL: verify your Supabase storage host in the TikTok portal.
# -----------------------------------------------------------------
TIKTOK_CLIENT_KEY=YOUR_TIKTOK_CLIENT_KEY
TIKTOK_CLIENT_SECRET=YOUR_TIKTOK_CLIENT_SECRET
# Optional: force a single registered callback origin
# TIKTOK_REDIRECT_URI=https://clikd.app/api/auth/callback/tiktok

# -----------------------------------------------------------------
# 4. LINKEDIN SHARE & GRAPH API
# Get keys at: https://www.linkedin.com/developers/
# -----------------------------------------------------------------
LINKEDIN_CLIENT_ID=YOUR_LINKEDIN_CLIENT_ID
LINKEDIN_CLIENT_SECRET=YOUR_LINKEDIN_CLIENT_SECRET

# -----------------------------------------------------------------
# 5. YOUTUBE + GOOGLE OAUTH (Drive / Calendar / Meet / YouTube)
# Enable APIs: YouTube Data API v3, Google Drive API, Google Calendar API
# OAuth redirect URIs:
#   {APP_URL}/api/auth/callback/youtube
#   {APP_URL}/api/auth/callback/google
#   https://clikd.app/api/auth/callback/google
#   http://localhost:4000/api/auth/callback/google
# -----------------------------------------------------------------
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# Optional API keys (Picker / Drive / Calendar public keys — OAuth still needs client id/secret)
GOOGLE_DRIVE_API_KEY=YOUR_GOOGLE_DRIVE_API_KEY
GOOGLE_CALENDAR_API_KEY=YOUR_GOOGLE_CALENDAR_API_KEY
# NEXT_PUBLIC_GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
NEXT_PUBLIC_APP_URL=http://localhost:4000

# -----------------------------------------------------------------
# 5b. PINTEREST DEVELOPER API
# Get keys at: https://developers.pinterest.com/
# Redirect URI: {APP_URL}/api/auth/callback/pinterest
# -----------------------------------------------------------------
PINTEREST_APP_ID=YOUR_PINTEREST_APP_ID
PINTEREST_APP_SECRET=YOUR_PINTEREST_APP_SECRET

# -----------------------------------------------------------------
# 6. PAYMENTS & CHECKOUT (STRIPE)
# Get keys at: https://dashboard.stripe.com/apikeys
# -----------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# -----------------------------------------------------------------
# 7. SUPABASE / DATABASE & AUTH
# Get keys at: https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Auth email redirects (Supabase Dashboard → Authentication → URL Configuration):
#   Site URL: http://localhost:4000 (prod: https://clikd.app)
#   Additional Redirect URLs:
#     http://localhost:4000/api/auth/callback
#     http://localhost:4000/update-password
#     https://clikd.app/api/auth/callback
#     https://clikd.app/update-password
# Optional public Storage bucket used by /api/upload (created automatically if missing)
# SUPABASE_STORAGE_BUCKET=media

# -----------------------------------------------------------------
# 8. RESEND (EMAIL CRM + TRANSACTIONAL)
# Get key at: https://resend.com/api-keys
# -----------------------------------------------------------------
RESEND_API_KEY=re_YOUR_RESEND_API_KEY_HERE
# Verified sender domain in Resend (falls back to onboarding@resend.dev in dev)
RESEND_FROM_EMAIL=clikd: <hello@clikd.app>
# Optional shared secret for POST /api/webhooks/resend (header x-resend-webhook-secret)
RESEND_WEBHOOK_SECRET=

# -----------------------------------------------------------------
# 9. VERCEL (CUSTOM DOMAINS — Pro) + CRON
# Token: https://vercel.com/account/tokens
# Project ID: Project Settings → General
# -----------------------------------------------------------------
VERCEL_AUTH_BEARER_TOKEN=YOUR_VERCEL_TOKEN_HERE
VERCEL_PROJECT_ID=YOUR_VERCEL_PROJECT_ID_HERE
# Optional if the project lives under a Vercel team
# VERCEL_TEAM_ID=
# Secures GET/POST /api/cron/monthly-reports (Authorization: Bearer …)
# Vercel Cron sends this automatically when set in project env
CRON_SECRET=YOUR_LONG_RANDOM_CRON_SECRET

# -----------------------------------------------------------------
# 10. APP / AUTH / DATABASE (clikd: runtime)
# -----------------------------------------------------------------
# Public site URL used for metadata, OAuth callbacks, and absolute links
NEXT_PUBLIC_SITE_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:4000
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=YOUR_BETTER_AUTH_SECRET
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:4000
# Optional production canonical. Do not let this override local OAuth —
# Connect uses the request host first (localhost:4000 vs clikd.app).
# NEXTAUTH_URL=https://clikd.app

# Postgres connection (Neon / Supabase / local). Used by better-auth + API routes.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Optional: force demo/memory auth when true (no real DB required)
# NEXT_PUBLIC_DEMO_AUTH=true

# Apple Sign In (optional)
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# APPLE_APP_BUNDLE_IDENTIFIER=

# Legacy Anything / Create.xyz proxy (optional fallback for older AI routes)
# NEXT_PUBLIC_CREATE_BASE_URL=
# NEXT_PUBLIC_CREATE_HOST=
# NEXT_PUBLIC_PROJECT_GROUP_ID=
# ANYTHING_PROJECT_TOKEN=
