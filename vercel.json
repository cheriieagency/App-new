{
  "buildCommand": "cd apps/web && npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/monthly-reports",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/publish",
      "schedule": "*/5 * * * *"
    }
  ]
}
